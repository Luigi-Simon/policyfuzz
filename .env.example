# Safe setup template. Never put real credentials or policy data in this file.
APP_MODE=cached
RUN_TTL_SECONDS=3600
# Exact local frontend origin for direct browser requests; Vite proxy uses same-origin.
POLICYFUZZ_ALLOWED_ORIGIN=http://127.0.0.1:5173
MAX_POLICY_CHARS=50000
LLM_PROVIDER=openai
# OpenAI defaults to gpt-5.6-luna; Bedrock defaults to amazon.nova-lite-v1:0.
# Override this with a model available to the selected provider account.
LLM_MODEL=
# Keep real credentials only in the server process environment. For Bedrock,
# use the temporary AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_SESSION_TOKEN
# exports from the AWS access portal; do not paste their values into this file.
OPENAI_API_KEY=
AWS_REGION=us-east-1
LLM_TIMEOUT_SECONDS=30
# Frontend: mock = authored synthetic workflow; http = public /api/v1 transport.
VITE_DATA_MODE=http
# Empty uses the Vite proxy (/api -> http://127.0.0.1:8000).
VITE_API_BASE_URL=
