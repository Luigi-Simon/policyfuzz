# Safe setup template. Never put real credentials or policy data in this file.
APP_MODE=cached
RUN_TTL_SECONDS=3600
# Exact local frontend origin for direct browser requests; Vite proxy uses same-origin.
POLICYFUZZ_ALLOWED_ORIGIN=http://127.0.0.1:5173
MAX_POLICY_CHARS=50000
LLM_PROVIDER=openai
# Set a supported model and server-side key before constructing the live adapter.
LLM_MODEL=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Frontend: mock = authored synthetic workflow; http = public /api/v1 transport.
VITE_DATA_MODE=http
# Empty uses the Vite proxy (/api -> http://127.0.0.1:8000).
VITE_API_BASE_URL=

# V2 live workflow. Keep keys server-side. MiroFish's LLM_API_KEY and
# LLM_MODEL_NAME aliases are also accepted without changing the v1 settings.
MIROFISH_BASE_URL=http://127.0.0.1:5002
# Optional separate Judge model; empty uses LLM_MODEL / LLM_MODEL_NAME.
JUDGE_MODEL=
JUDGE_TIMEOUT_SECONDS=150
JUDGE_MAX_REPAIRS=2
JUDGE_RESPONSE_FORMAT=json_schema
# Explicit dotenv file for the v2 API, or use dev:v2 -- --env-file PATH.
# POLICYFUZZ_V2_ENV_FILE=/absolute/path/to/local.env
