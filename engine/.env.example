# OpenAI-compatible LLM (same shape as MiroFish)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Set true to skip the LLM and use the heuristic extractor (CI / local)
LLM_MOCK=false

# Where run artifacts are stored
DATA_DIR=./data

# CORS for the React frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Person 3 defaults to the built-in fuzzer + rule grader.
# Override only if you swap the implementation.
# SCENARIO_DESIGNER=app.services.fuzz:FuzzDesigner
# EVALUATOR=app.services.evaluate:RuleEvaluator

# Hard cap for fuzz agents (Person 3 grader)
MAX_SWARM_AGENTS=50
# Live MiroFish speakers (keep small so they actually reply)
MIROFISH_LIVE_AGENTS=12
MIROFISH_USE_LLM_PROFILES=false

# MiroFish swarm sim (agent-to-agent sentiment)
# Leave empty to score from fuzz tests only, and upload seed.md in the MiroFish UI
# Set to http://localhost:5001 then POST /v1/runs/{id}/rehearse?swarm=true
MIROFISH_BASE_URL=
MIROFISH_AUTO_LAUNCH=false
MIROFISH_AUTO_SWARM=false
MIROFISH_TIMEOUT_SECONDS=120
MIROFISH_SWARM_TIMEOUT_SECONDS=900
MIROFISH_POLL_SECONDS=5
MIROFISH_MAX_ROUNDS=8
MIROFISH_PLATFORM=twitter
