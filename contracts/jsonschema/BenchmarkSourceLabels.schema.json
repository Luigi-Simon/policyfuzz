{
  "$defs": {
    "BenchmarkSourceLabel": {
      "additionalProperties": false,
      "properties": {
        "label_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label Id",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "unsupported_clause_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Clause Id"
        }
      },
      "required": [
        "label_id",
        "source_span",
        "rule_ids"
      ],
      "title": "BenchmarkSourceLabel",
      "type": "object"
    },
    "PolicyDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PolicyPage"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "pasted_text",
            "bundled_sample"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "title",
        "source_type",
        "pages",
        "document_sha256"
      ],
      "title": "PolicyDocument",
      "type": "object"
    },
    "PolicyPage": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "page",
        "text",
        "start",
        "end"
      ],
      "title": "PolicyPage",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "start",
        "end",
        "quote",
        "quote_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document": {
      "$ref": "#/$defs/PolicyDocument"
    },
    "labels": {
      "items": {
        "$ref": "#/$defs/BenchmarkSourceLabel"
      },
      "title": "Labels",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "document",
    "labels"
  ],
  "title": "BenchmarkSourceLabels",
  "type": "object"
}
