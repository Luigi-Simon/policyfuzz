{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "enum": [
                "COMPLIANT",
                "NONCOMPLIANT"
              ],
              "type": "string"
            }
          ],
          "title": "Expected Value"
        },
        "gold_label_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gold Label Id"
        },
        "mechanical_relation_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanical Relation Id"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "lte",
            "gte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "origin": {
          "enum": [
            "gold",
            "session_confirmed",
            "mechanical"
          ],
          "title": "Origin",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_invariant_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Invariant Id"
        },
        "target_kind": {
          "enum": [
            "effect_value",
            "compliance_value"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "target_kind",
        "dimension",
        "operator",
        "expected_value",
        "origin"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "BenchmarkDefect": {
      "additionalProperties": false,
      "properties": {
        "defect_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Defect Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "expected_finding_fingerprint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Finding Fingerprint Sha256"
        },
        "finding_type": {
          "enum": [
            "structural_gap",
            "conflict",
            "intent_breach",
            "regression",
            "unsupported_clause",
            "potential_loophole"
          ],
          "title": "Finding Type",
          "type": "string"
        },
        "partition": {
          "default": "visible",
          "enum": [
            "visible",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "permitted_witness_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Permitted Witness Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_signature_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Signature Sha256"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Source Spans",
          "type": "array"
        },
        "target_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        },
        "unsupported_clause": {
          "default": false,
          "title": "Unsupported Clause",
          "type": "boolean"
        }
      },
      "required": [
        "defect_id",
        "finding_type",
        "dimension",
        "target_ids",
        "severity"
      ],
      "title": "BenchmarkDefect",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Assertion"
          },
          "title": "Assertions",
          "type": "array"
        },
        "category": {
          "enum": [
            "normal",
            "boundary",
            "adversarial"
          ],
          "title": "Category",
          "type": "string"
        },
        "facts": {
          "$ref": "#/$defs/ScenarioFacts"
        },
        "origins": {
          "items": {
            "enum": [
              "gold",
              "session",
              "mechanical",
              "llm_exploratory"
            ],
            "type": "string"
          },
          "minLength": 1,
          "title": "Origins",
          "type": "array",
          "uniqueItems": true
        },
        "partition": {
          "default": "visible",
          "enum": [
            "visible",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "protected": {
          "default": false,
          "title": "Protected",
          "type": "boolean"
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_invariant_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Invariant Ids",
          "type": "array"
        },
        "target_rule_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "category",
        "origins",
        "facts"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "ScenarioFacts": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Amount Minor",
          "type": "integer"
        },
        "approval_roles_present": {
          "items": {
            "enum": [
              "manager",
              "director",
              "finance"
            ],
            "type": "string"
          },
          "title": "Approval Roles Present",
          "type": "array",
          "uniqueItems": true
        },
        "booking_days_before": {
          "maximum": 365,
          "minimum": 0,
          "title": "Booking Days Before",
          "type": "integer"
        },
        "destination_type": {
          "enum": [
            "domestic",
            "international"
          ],
          "title": "Destination Type",
          "type": "string"
        },
        "employee_role": {
          "enum": [
            "employee",
            "manager",
            "director",
            "executive"
          ],
          "title": "Employee Role",
          "type": "string"
        },
        "expense_category": {
          "enum": [
            "meal",
            "hotel",
            "transport",
            "airfare",
            "incidental"
          ],
          "title": "Expense Category",
          "type": "string"
        },
        "prior_same_day_category_spend_minor": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Prior Same Day Category Spend Minor",
          "type": "integer"
        },
        "receipt_present": {
          "title": "Receipt Present",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "employee_role",
        "expense_category",
        "amount_minor",
        "destination_type",
        "booking_days_before",
        "receipt_present",
        "approval_roles_present",
        "prior_same_day_category_spend_minor"
      ],
      "title": "ScenarioFacts",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "start",
        "end",
        "quote",
        "quote_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Private scoring input; must never be nested inside a RunView.",
  "properties": {
    "benchmark_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Benchmark Id",
      "type": "string"
    },
    "defects": {
      "items": {
        "$ref": "#/$defs/BenchmarkDefect"
      },
      "title": "Defects",
      "type": "array"
    },
    "document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Document Sha256",
      "type": "string"
    },
    "engine_version": {
      "minLength": 1,
      "title": "Engine Version",
      "type": "string"
    },
    "gold_scenarios": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "title": "Gold Scenarios",
      "type": "array"
    },
    "policy_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Contract Sha256",
      "type": "string"
    },
    "required_dimensions": {
      "items": {
        "enum": [
          "eligibility",
          "receipt_requirement",
          "approval_requirement",
          "claim_cap_minor",
          "daily_category_cap_minor"
        ],
        "type": "string"
      },
      "title": "Required Dimensions",
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seal Sha256",
      "type": "string"
    },
    "sealed_at": {
      "format": "date-time",
      "title": "Sealed At",
      "type": "string"
    }
  },
  "required": [
    "benchmark_id",
    "document_sha256",
    "policy_contract_sha256",
    "engine_version",
    "sealed_at",
    "seal_sha256",
    "defects",
    "gold_scenarios",
    "required_dimensions"
  ],
  "title": "BenchmarkManifest",
  "type": "object"
}
