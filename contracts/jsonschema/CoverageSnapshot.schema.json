{
  "$defs": {
    "CoverageEvidence": {
      "additionalProperties": false,
      "properties": {
        "predicate_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Index"
        },
        "predicate_outcome": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Outcome"
        },
        "scenario_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Scenario Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "rule",
            "invariant",
            "predicate_branch"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "target_kind",
        "target_id",
        "scenario_ids"
      ],
      "title": "CoverageEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "covered_invariants": {
      "default": 0,
      "minimum": 0,
      "title": "Covered Invariants",
      "type": "integer"
    },
    "covered_predicate_branches": {
      "default": 0,
      "minimum": 0,
      "title": "Covered Predicate Branches",
      "type": "integer"
    },
    "covered_rules": {
      "default": 0,
      "minimum": 0,
      "title": "Covered Rules",
      "type": "integer"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CoverageEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "missing_invariant_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Invariant Ids",
      "type": "array"
    },
    "missing_rule_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Rule Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "satisfied",
        "COVERAGE_LIMIT_EXCEEDED"
      ],
      "title": "Status",
      "type": "string"
    },
    "targeted_cycles": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Targeted Cycles",
      "type": "integer"
    },
    "total_invariants": {
      "default": 0,
      "minimum": 0,
      "title": "Total Invariants",
      "type": "integer"
    },
    "total_predicate_branches": {
      "default": 0,
      "minimum": 0,
      "title": "Total Predicate Branches",
      "type": "integer"
    },
    "total_rules": {
      "default": 0,
      "minimum": 0,
      "title": "Total Rules",
      "type": "integer"
    }
  },
  "title": "CoverageSnapshot",
  "type": "object"
}
