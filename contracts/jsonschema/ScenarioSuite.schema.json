{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "enum": [
                "COMPLIANT",
                "NONCOMPLIANT"
              ],
              "type": "string"
            }
          ],
          "title": "Expected Value"
        },
        "gold_label_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gold Label Id"
        },
        "mechanical_relation_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanical Relation Id"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "lte",
            "gte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "origin": {
          "enum": [
            "gold",
            "session_confirmed",
            "mechanical"
          ],
          "title": "Origin",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_invariant_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Invariant Id"
        },
        "target_kind": {
          "enum": [
            "effect_value",
            "compliance_value"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "target_kind",
        "dimension",
        "operator",
        "expected_value",
        "origin"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Assertion"
          },
          "title": "Assertions",
          "type": "array"
        },
        "category": {
          "enum": [
            "normal",
            "boundary",
            "adversarial"
          ],
          "title": "Category",
          "type": "string"
        },
        "facts": {
          "$ref": "#/$defs/ScenarioFacts"
        },
        "origins": {
          "items": {
            "enum": [
              "gold",
              "session",
              "mechanical",
              "llm_exploratory"
            ],
            "type": "string"
          },
          "minLength": 1,
          "title": "Origins",
          "type": "array",
          "uniqueItems": true
        },
        "partition": {
          "default": "visible",
          "enum": [
            "visible",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "protected": {
          "default": false,
          "title": "Protected",
          "type": "boolean"
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_invariant_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Invariant Ids",
          "type": "array"
        },
        "target_rule_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "category",
        "origins",
        "facts"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "ScenarioFacts": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Amount Minor",
          "type": "integer"
        },
        "approval_roles_present": {
          "items": {
            "enum": [
              "manager",
              "director",
              "finance"
            ],
            "type": "string"
          },
          "title": "Approval Roles Present",
          "type": "array",
          "uniqueItems": true
        },
        "booking_days_before": {
          "maximum": 365,
          "minimum": 0,
          "title": "Booking Days Before",
          "type": "integer"
        },
        "destination_type": {
          "enum": [
            "domestic",
            "international"
          ],
          "title": "Destination Type",
          "type": "string"
        },
        "employee_role": {
          "enum": [
            "employee",
            "manager",
            "director",
            "executive"
          ],
          "title": "Employee Role",
          "type": "string"
        },
        "expense_category": {
          "enum": [
            "meal",
            "hotel",
            "transport",
            "airfare",
            "incidental"
          ],
          "title": "Expense Category",
          "type": "string"
        },
        "prior_same_day_category_spend_minor": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Prior Same Day Category Spend Minor",
          "type": "integer"
        },
        "receipt_present": {
          "title": "Receipt Present",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "employee_role",
        "expense_category",
        "amount_minor",
        "destination_type",
        "booking_days_before",
        "receipt_present",
        "approval_roles_present",
        "prior_same_day_category_spend_minor"
      ],
      "title": "ScenarioFacts",
      "type": "object"
    },
    "ScenarioRejection": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "reason_code": {
          "enum": [
            "invalid_facts",
            "invalid_assertion",
            "duplicate",
            "budget_exceeded",
            "incompatible_assertions"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "reason_code"
      ],
      "title": "ScenarioRejection",
      "type": "object"
    },
    "SuiteStatistics": {
      "additionalProperties": false,
      "properties": {
        "duplicate_count": {
          "default": 0,
          "minimum": 0,
          "title": "Duplicate Count",
          "type": "integer"
        },
        "generated_count": {
          "default": 0,
          "minimum": 0,
          "title": "Generated Count",
          "type": "integer"
        },
        "rejected_count": {
          "default": 0,
          "minimum": 0,
          "title": "Rejected Count",
          "type": "integer"
        },
        "rejections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScenarioRejection"
          },
          "title": "Rejections",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "SuiteStatistics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Document Sha256",
      "type": "string"
    },
    "engine_version": {
      "minLength": 1,
      "title": "Engine Version",
      "type": "string"
    },
    "policy_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Contract Sha256",
      "type": "string"
    },
    "rule_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rule Set Sha256",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "maxItems": 15,
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "statistics": {
      "$ref": "#/$defs/SuiteStatistics"
    },
    "suite_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Suite Id",
      "type": "string"
    }
  },
  "required": [
    "suite_id",
    "content_sha256",
    "seed",
    "document_sha256",
    "policy_contract_sha256",
    "rule_set_sha256",
    "engine_version",
    "scenarios"
  ],
  "title": "ScenarioSuite",
  "type": "object"
}
