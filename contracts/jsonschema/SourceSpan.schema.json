    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "section": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section"
    },
    "start": {
      "minimum": 0,
      "title": "Start",
      "type": "integer"
    }
  },
  "required": [
    "page",
    "start",
    "end",
    "quote",
    "quote_sha256"
