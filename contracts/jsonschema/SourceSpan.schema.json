{
  "additionalProperties": false,
  "properties": {
    "end": {
      "minimum": 0,
      "title": "End",
      "type": "integer"
    },
    "page": {
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "quote": {
      "minLength": 1,
      "title": "Quote",
      "type": "string"
    },
