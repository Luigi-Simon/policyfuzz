{
  "$defs": {
    "AssertionCounts": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "default": 0,
          "minimum": 0,
          "title": "Error",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "inconclusive": {
          "default": 0,
          "minimum": 0,
          "title": "Inconclusive",
          "type": "integer"
        },
        "passed": {
          "default": 0,
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "AssertionCounts",
      "type": "object"
    },
    "AssertionTransition": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "ERROR"
          ],
          "title": "After",
          "type": "string"
        },
        "assertion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "before": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "ERROR"
          ],
          "title": "Before",
          "type": "string"
        },
        "protected": {
          "title": "Protected",
          "type": "boolean"
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "targeted": {
          "title": "Targeted",
          "type": "boolean"
        }
      },
      "required": [
        "scenario_id",
        "assertion_id",
        "before",
        "after",
        "protected",
        "targeted"
      ],
      "title": "AssertionTransition",
      "type": "object"
    },
    "AssertionTransitionCounts": {
      "additionalProperties": false,
      "properties": {
        "fail_to_fail": {
          "default": 0,
          "minimum": 0,
          "title": "Fail To Fail",
          "type": "integer"
        },
        "fail_to_pass": {
          "default": 0,
          "minimum": 0,
          "title": "Fail To Pass",
          "type": "integer"
        },
        "inconclusive_or_error": {
          "default": 0,
          "minimum": 0,
          "title": "Inconclusive Or Error",
          "type": "integer"
        },
        "pass_to_fail": {
          "default": 0,
          "minimum": 0,
          "title": "Pass To Fail",
          "type": "integer"
        },
        "pass_to_pass": {
          "default": 0,
          "minimum": 0,
          "title": "Pass To Pass",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "AssertionTransitionCounts",
      "type": "object"
    },
    "CoverageEvidence": {
      "additionalProperties": false,
      "properties": {
        "predicate_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Index"
        },
        "predicate_outcome": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Outcome"
        },
        "scenario_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Scenario Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "rule",
            "invariant",
            "predicate_branch"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "target_kind",
        "target_id",
        "scenario_ids"
      ],
      "title": "CoverageEvidence",
      "type": "object"
    },
    "CoverageSnapshot": {
      "additionalProperties": false,
      "properties": {
        "covered_invariants": {
          "default": 0,
          "minimum": 0,
          "title": "Covered Invariants",
          "type": "integer"
        },
        "covered_predicate_branches": {
          "default": 0,
          "minimum": 0,
          "title": "Covered Predicate Branches",
          "type": "integer"
        },
        "covered_rules": {
          "default": 0,
          "minimum": 0,
          "title": "Covered Rules",
          "type": "integer"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CoverageEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "missing_invariant_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Invariant Ids",
          "type": "array"
        },
        "missing_rule_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Rule Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "satisfied",
            "COVERAGE_LIMIT_EXCEEDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "targeted_cycles": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Targeted Cycles",
          "type": "integer"
        },
        "total_invariants": {
          "default": 0,
          "minimum": 0,
          "title": "Total Invariants",
          "type": "integer"
        },
        "total_predicate_branches": {
          "default": 0,
          "minimum": 0,
          "title": "Total Predicate Branches",
          "type": "integer"
        },
        "total_rules": {
          "default": 0,
          "minimum": 0,
          "title": "Total Rules",
          "type": "integer"
        }
      },
      "title": "CoverageSnapshot",
      "type": "object"
    },
    "EffectStateCounts": {
      "additionalProperties": false,
      "properties": {
        "CONFLICT": {
          "default": 0,
          "minimum": 0,
          "title": "Conflict",
          "type": "integer"
        },
        "ERROR": {
          "default": 0,
          "minimum": 0,
          "title": "Error",
          "type": "integer"
        },
        "GAP": {
          "default": 0,
          "minimum": 0,
          "title": "Gap",
          "type": "integer"
        },
        "INCONCLUSIVE": {
          "default": 0,
          "minimum": 0,
          "title": "Inconclusive",
          "type": "integer"
        },
        "NOT_APPLICABLE": {
          "default": 0,
          "minimum": 0,
          "title": "Not Applicable",
          "type": "integer"
        },
        "VALUE": {
          "default": 0,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "EffectStateCounts",
      "type": "object"
    },
    "InputHashes": {
      "additionalProperties": false,
      "properties": {
        "contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "engine_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Engine Sha256",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "suite_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suite Sha256",
          "type": "string"
        }
      },
      "required": [
        "policy_sha256",
        "contract_sha256",
        "suite_sha256",
        "engine_sha256",
        "run_manifest_sha256"
      ],
      "title": "InputHashes",
      "type": "object"
    },
    "MetricsReport": {
      "additionalProperties": false,
      "properties": {
        "assertion_pass_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assertion Pass Percent"
        },
        "assertions": {
          "$ref": "#/$defs/AssertionCounts"
        },
        "coverage": {
          "$ref": "#/$defs/CoverageSnapshot"
        },
        "effect_states": {
          "$ref": "#/$defs/EffectStateCounts"
        },
        "inputs": {
          "$ref": "#/$defs/InputHashes"
        },
        "scenario_count": {
          "minimum": 0,
          "title": "Scenario Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unique_finding_count": {
          "minimum": 0,
          "title": "Unique Finding Count",
          "type": "integer"
        }
      },
      "required": [
        "inputs",
        "scenario_count",
        "effect_states",
        "assertions",
        "unique_finding_count",
        "coverage"
      ],
      "title": "MetricsReport",
      "type": "object"
    },
    "PatchAcceptanceCounts": {
      "additionalProperties": false,
      "properties": {
        "baseline_gap_conflict_inconclusive_or_error": {
          "default": 0,
          "minimum": 0,
          "title": "Baseline Gap Conflict Inconclusive Or Error",
          "type": "integer"
        },
        "fixed_target_findings": {
          "default": 0,
          "minimum": 0,
          "title": "Fixed Target Findings",
          "type": "integer"
        },
        "holdout_regressions": {
          "default": 0,
          "minimum": 0,
          "title": "Holdout Regressions",
          "type": "integer"
        },
        "new_failures_outside_targets": {
          "default": 0,
          "minimum": 0,
          "title": "New Failures Outside Targets",
          "type": "integer"
        },
        "protected_regressions": {
          "default": 0,
          "minimum": 0,
          "title": "Protected Regressions",
          "type": "integer"
        },
        "revised_gap_conflict_inconclusive_or_error": {
          "default": 0,
          "minimum": 0,
          "title": "Revised Gap Conflict Inconclusive Or Error",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_findings": {
          "default": 0,
          "minimum": 0,
          "title": "Target Findings",
          "type": "integer"
        },
        "unrelated_rule_changes": {
          "default": 0,
          "minimum": 0,
          "title": "Unrelated Rule Changes",
          "type": "integer"
        }
      },
      "title": "PatchAcceptanceCounts",
      "type": "object"
    },
    "PatchAcceptanceReport": {
      "additionalProperties": false,
      "properties": {
        "all_target_findings_fixed": {
          "title": "All Target Findings Fixed",
          "type": "boolean"
        },
        "baseline_inputs": {
          "$ref": "#/$defs/InputHashes"
        },
        "counts": {
          "$ref": "#/$defs/PatchAcceptanceCounts"
        },
        "holdout_not_worse": {
          "title": "Holdout Not Worse",
          "type": "boolean"
        },
        "no_increase_in_gap_conflict_inconclusive_or_error": {
          "title": "No Increase In Gap Conflict Inconclusive Or Error",
          "type": "boolean"
        },
        "patch_accepted": {
          "title": "Patch Accepted",
          "type": "boolean"
        },
        "revised_inputs": {
          "$ref": "#/$defs/InputHashes"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "suite_hash_matches": {
          "title": "Suite Hash Matches",
          "type": "boolean"
        },
        "unrelated_rules_unchanged": {
          "title": "Unrelated Rules Unchanged",
          "type": "boolean"
        },
        "zero_new_failures_outside_targets": {
          "title": "Zero New Failures Outside Targets",
          "type": "boolean"
        },
        "zero_protected_regressions": {
          "title": "Zero Protected Regressions",
          "type": "boolean"
        }
      },
      "required": [
        "baseline_inputs",
        "revised_inputs",
        "suite_hash_matches",
        "all_target_findings_fixed",
        "zero_new_failures_outside_targets",
        "zero_protected_regressions",
        "no_increase_in_gap_conflict_inconclusive_or_error",
        "unrelated_rules_unchanged",
        "holdout_not_worse",
        "patch_accepted"
      ],
      "title": "PatchAcceptanceReport",
      "type": "object"
    },
    "RegressionReport": {
      "additionalProperties": false,
      "properties": {
        "assertion_transition_counts": {
          "$ref": "#/$defs/AssertionTransitionCounts"
        },
        "assertion_transitions": {
          "items": {
            "$ref": "#/$defs/AssertionTransition"
          },
          "title": "Assertion Transitions",
          "type": "array"
        },
        "baseline_effect_states": {
          "$ref": "#/$defs/EffectStateCounts"
        },
        "baseline_inputs": {
          "$ref": "#/$defs/InputHashes"
        },
        "report_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        },
        "revised_effect_states": {
          "$ref": "#/$defs/EffectStateCounts"
        },
        "revised_inputs": {
          "$ref": "#/$defs/InputHashes"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "baseline_inputs",
        "revised_inputs",
        "baseline_effect_states",
        "revised_effect_states",
        "assertion_transition_counts",
        "assertion_transitions"
      ],
      "title": "RegressionReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance": {
      "$ref": "#/$defs/PatchAcceptanceReport"
    },
    "baseline_inputs": {
      "$ref": "#/$defs/InputHashes"
    },
    "baseline_metrics": {
      "$ref": "#/$defs/MetricsReport"
    },
    "regression": {
      "$ref": "#/$defs/RegressionReport"
    },
    "revised_inputs": {
      "$ref": "#/$defs/InputHashes"
    },
    "revised_metrics": {
      "$ref": "#/$defs/MetricsReport"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "baseline_inputs",
    "revised_inputs",
    "regression",
    "acceptance",
    "baseline_metrics",
    "revised_metrics"
  ],
  "title": "ComparisonBundle",
  "type": "object"
}
