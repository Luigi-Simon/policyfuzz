{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "enum": [
                "COMPLIANT",
                "NONCOMPLIANT"
              ],
              "type": "string"
            }
          ],
          "title": "Expected Value"
        },
        "gold_label_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gold Label Id"
        },
        "mechanical_relation_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanical Relation Id"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "lte",
            "gte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "origin": {
          "enum": [
            "gold",
            "session_confirmed",
            "mechanical"
          ],
          "title": "Origin",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_invariant_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Invariant Id"
        },
        "target_kind": {
          "enum": [
            "effect_value",
            "compliance_value"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "target_kind",
        "dimension",
        "operator",
        "expected_value",
        "origin"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "title": "Effect",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assertion Id"
        },
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Citations",
          "type": "array"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "evidence_level": {
          "enum": [
            "mechanically_reproduced",
            "session_confirmed",
            "candidate"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "finding_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "finding_type": {
          "enum": [
            "structural_gap",
            "conflict",
            "intent_breach",
            "regression",
            "unsupported_clause",
            "potential_loophole"
          ],
          "title": "Finding Type",
          "type": "string"
        },
        "fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint Sha256",
          "type": "string"
        },
        "invariant_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invariant Id"
        },
        "review_status": {
          "default": "pending",
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "rule_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "scenario_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Scenario Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "severity_origin": {
          "anyOf": [
            {
              "enum": [
                "session_invariant",
                "session_reviewer"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Origin"
        },
        "traces": {
          "items": {
            "$ref": "#/$defs/TraceRef"
          },
          "minItems": 1,
          "title": "Traces",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "fingerprint_sha256",
        "finding_type",
        "evidence_level",
        "scenario_ids",
        "dimension",
        "traces"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingDecision": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "accept",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "finding_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "reviewer_severity": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Severity"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "decision"
      ],
      "title": "FindingDecision",
      "type": "object"
    },
    "FindingReport": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "inputs": {
          "$ref": "#/$defs/InputHashes"
        },
        "report_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "inputs",
        "findings"
      ],
      "title": "FindingReport",
      "type": "object"
    },
    "InputHashes": {
      "additionalProperties": false,
      "properties": {
        "contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "engine_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Engine Sha256",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "suite_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suite Sha256",
          "type": "string"
        }
      },
      "required": [
        "policy_sha256",
        "contract_sha256",
        "suite_sha256",
        "engine_sha256",
        "run_manifest_sha256"
      ],
      "title": "InputHashes",
      "type": "object"
    },
    "Invariant": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "$ref": "#/$defs/Assertion"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "invariant_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Invariant Id",
          "type": "string"
        },
        "origin": {
          "const": "session_confirmed",
          "default": "session_confirmed",
          "title": "Origin",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "when": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "When",
          "type": "array"
        }
      },
      "required": [
        "invariant_id",
        "description",
        "when",
        "assertion",
        "severity"
      ],
      "title": "Invariant",
      "type": "object"
    },
    "OverrideRef": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Rule Id",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "target_rule_id"
      ],
      "title": "OverrideRef",
      "type": "object"
    },
    "PolicyContract": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "invariants": {
          "items": {
            "$ref": "#/$defs/Invariant"
          },
          "maxItems": 5,
          "minItems": 3,
          "title": "Invariants",
          "type": "array"
        },
        "required_dimensions": {
          "items": {
            "enum": [
              "eligibility",
              "receipt_requirement",
              "approval_requirement",
              "claim_cap_minor",
              "daily_category_cap_minor"
            ],
            "type": "string"
          },
          "minLength": 1,
          "title": "Required Dimensions",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "required_dimensions",
        "invariants"
      ],
      "title": "PolicyContract",
      "type": "object"
    },
    "PolicyIR": {
      "additionalProperties": false,
      "properties": {
        "base_currency": {
          "const": "SGD",
          "default": "SGD",
          "title": "Base Currency",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "kind": {
          "default": "compiled_baseline",
          "enum": [
            "compiled_baseline",
            "structured_revision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "provisional",
            "session_confirmed"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "maxItems": 12,
          "title": "Rules",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unsupported_clauses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnsupportedClause"
          },
          "title": "Unsupported Clauses",
          "type": "array"
        }
      },
      "required": [
        "policy_id",
        "document_sha256",
        "review_status",
        "rules"
      ],
      "title": "PolicyIR",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "enum": [
                "employee_role",
                "expense_category",
                "amount_minor",
                "destination_type",
                "booking_days_before",
                "receipt_present",
                "approval_roles_present",
                "prior_same_day_category_spend_minor"
              ],
              "type": "string"
            },
            {
              "const": "daily_category_total_minor",
              "type": "string"
            }
          ],
          "title": "Field"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "lt",
            "lte",
            "gt",
            "gte",
            "contains"
          ],
          "title": "Operator",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "confidence_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Percent"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "minItems": 1,
          "title": "Effects",
          "type": "array"
        },
        "overrides": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverrideRef"
          },
          "title": "Overrides",
          "type": "array"
        },
        "provenance": {
          "discriminator": {
            "mapping": {
              "session_revision": "#/$defs/SessionRevisionProvenance",
              "text_citation": "#/$defs/TextRuleProvenance"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextRuleProvenance"
            },
            {
              "$ref": "#/$defs/SessionRevisionProvenance"
            }
          ],
          "title": "Provenance"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "when": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "When",
          "type": "array"
        }
      },
      "required": [
        "description",
        "when",
        "effects",
        "provenance",
        "rule_id"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Assertion"
          },
          "title": "Assertions",
          "type": "array"
        },
        "category": {
          "enum": [
            "normal",
            "boundary",
            "adversarial"
          ],
          "title": "Category",
          "type": "string"
        },
        "facts": {
          "$ref": "#/$defs/ScenarioFacts"
        },
        "origins": {
          "items": {
            "enum": [
              "gold",
              "session",
              "mechanical",
              "llm_exploratory"
            ],
            "type": "string"
          },
          "minLength": 1,
          "title": "Origins",
          "type": "array",
          "uniqueItems": true
        },
        "partition": {
          "default": "visible",
          "enum": [
            "visible",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "protected": {
          "default": false,
          "title": "Protected",
          "type": "boolean"
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_invariant_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Invariant Ids",
          "type": "array"
        },
        "target_rule_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "category",
        "origins",
        "facts"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "ScenarioFacts": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Amount Minor",
          "type": "integer"
        },
        "approval_roles_present": {
          "items": {
            "enum": [
              "manager",
              "director",
              "finance"
            ],
            "type": "string"
          },
          "title": "Approval Roles Present",
          "type": "array",
          "uniqueItems": true
        },
        "booking_days_before": {
          "maximum": 365,
          "minimum": 0,
          "title": "Booking Days Before",
          "type": "integer"
        },
        "destination_type": {
          "enum": [
            "domestic",
            "international"
          ],
          "title": "Destination Type",
          "type": "string"
        },
        "employee_role": {
          "enum": [
            "employee",
            "manager",
            "director",
            "executive"
          ],
          "title": "Employee Role",
          "type": "string"
        },
        "expense_category": {
          "enum": [
            "meal",
            "hotel",
            "transport",
            "airfare",
            "incidental"
          ],
          "title": "Expense Category",
          "type": "string"
        },
        "prior_same_day_category_spend_minor": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Prior Same Day Category Spend Minor",
          "type": "integer"
        },
        "receipt_present": {
          "title": "Receipt Present",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "employee_role",
        "expense_category",
        "amount_minor",
        "destination_type",
        "booking_days_before",
        "receipt_present",
        "approval_roles_present",
        "prior_same_day_category_spend_minor"
      ],
      "title": "ScenarioFacts",
      "type": "object"
    },
    "ScenarioRejection": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
