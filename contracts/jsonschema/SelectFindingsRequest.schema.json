            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Severity"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "decision"
      ],
      "title": "FindingDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decisions": {
