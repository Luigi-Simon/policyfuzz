      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "decisions"
  ],
  "title": "SelectFindingsRequest",
  "type": "object"
