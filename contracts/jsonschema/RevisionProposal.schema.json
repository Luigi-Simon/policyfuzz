{
  "$defs": {
    "AddOverrideOperation": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Ids",
          "type": "array"
        },
        "kind": {
          "const": "add_override",
          "default": "add_override",
          "title": "Kind",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "dimension",
        "target_rule_id",
        "finding_ids"
      ],
      "title": "AddOverrideOperation",
      "type": "object"
    },
    "AddRuleOperation": {
      "additionalProperties": false,
      "properties": {
        "finding_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Ids",
          "type": "array"
        },
        "kind": {
          "const": "add_rule",
          "default": "add_rule",
          "title": "Kind",
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/RevisionRuleDraft"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "rule",
        "finding_ids"
      ],
      "title": "AddRuleOperation",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "title": "Effect",
      "type": "object"
    },
    "OverrideRef": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Rule Id",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "target_rule_id"
      ],
      "title": "OverrideRef",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "enum": [
                "employee_role",
                "expense_category",
                "amount_minor",
                "destination_type",
                "booking_days_before",
                "receipt_present",
                "approval_roles_present",
                "prior_same_day_category_spend_minor"
              ],
              "type": "string"
            },
            {
              "const": "daily_category_total_minor",
              "type": "string"
            }
          ],
          "title": "Field"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "lt",
            "lte",
            "gt",
            "gte",
            "contains"
          ],
          "title": "Operator",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "ReplaceRuleOperation": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "finding_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Ids",
          "type": "array"
        },
        "kind": {
          "const": "replace_rule",
          "default": "replace_rule",
          "title": "Kind",
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/RevisionRuleDraft"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "expected_revision",
        "rule",
        "finding_ids"
      ],
      "title": "ReplaceRuleOperation",
      "type": "object"
    },
    "RevisionRuleDraft": {
      "additionalProperties": false,
      "description": "Proposed rule content. Confirmation provenance is assigned only on application.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "minItems": 1,
          "title": "Effects",
          "type": "array"
        },
        "overrides": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverrideRef"
          },
          "title": "Overrides",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "when": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "minItems": 1,
          "title": "When",
          "type": "array"
        }
      },
      "required": [
        "description",
        "when",
        "effects"
      ],
      "title": "RevisionRuleDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_finding_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Accepted Finding Ids",
      "type": "array"
    },
    "document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Document Sha256",
      "type": "string"
    },
    "draft_policy_wording": {
      "minLength": 1,
      "title": "Draft Policy Wording",
      "type": "string"
    },
    "operations": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_override": "#/$defs/AddOverrideOperation",
            "add_rule": "#/$defs/AddRuleOperation",
            "replace_rule": "#/$defs/ReplaceRuleOperation"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/AddRuleOperation"
          },
          {
            "$ref": "#/$defs/ReplaceRuleOperation"
          },
          {
            "$ref": "#/$defs/AddOverrideOperation"
          }
        ]
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "policy_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Contract Sha256",
      "type": "string"
    },
    "proposal_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Proposal Id",
      "type": "string"
    },
    "rule_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rule Set Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Suite Sha256",
      "type": "string"
    }
  },
  "required": [
    "proposal_id",
    "document_sha256",
    "rule_set_sha256",
    "policy_contract_sha256",
    "suite_sha256",
    "accepted_finding_ids",
    "operations",
    "draft_policy_wording"
  ],
  "title": "RevisionProposal",
  "type": "object"
}
