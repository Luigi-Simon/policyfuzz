{
  "$defs": {
    "AssertionContent": {
      "additionalProperties": false,
      "description": "Typed assertion content, without oracle origins or private label references.",
      "properties": {
        "assertion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "enum": [
                "COMPLIANT",
                "NONCOMPLIANT"
              ],
              "type": "string"
            }
          ],
          "title": "Expected Value"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "lte",
            "gte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "effect_value",
            "compliance_value"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "target_kind",
        "dimension",
        "operator",
        "expected_value"
      ],
      "title": "AssertionContent",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "title": "Effect",
      "type": "object"
    },
    "InvariantSuggestion": {
      "additionalProperties": false,
      "description": "Unconfirmed model-authored intent for explicit reviewer confirmation.",
      "properties": {
        "assertion": {
          "$ref": "#/$defs/AssertionContent"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "invariant_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Invariant Id",
          "type": "string"
        },
        "origin": {
          "const": "model_suggestion",
          "default": "model_suggestion",
          "title": "Origin",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "when": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "When",
          "type": "array"
        }
      },
      "required": [
        "invariant_id",
        "description",
        "rationale",
        "when",
        "assertion"
      ],
      "title": "InvariantSuggestion",
      "type": "object"
    },
    "OverrideRef": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Rule Id",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "target_rule_id"
      ],
      "title": "OverrideRef",
      "type": "object"
    },
    "PolicyIR": {
      "additionalProperties": false,
      "properties": {
        "base_currency": {
          "const": "SGD",
          "default": "SGD",
          "title": "Base Currency",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "kind": {
          "default": "compiled_baseline",
          "enum": [
            "compiled_baseline",
            "structured_revision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "provisional",
            "session_confirmed"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "maxItems": 12,
          "title": "Rules",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unsupported_clauses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnsupportedClause"
          },
          "title": "Unsupported Clauses",
          "type": "array"
        }
      },
      "required": [
        "policy_id",
        "document_sha256",
        "review_status",
        "rules"
      ],
      "title": "PolicyIR",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "enum": [
                "employee_role",
                "expense_category",
                "amount_minor",
                "destination_type",
                "booking_days_before",
                "receipt_present",
                "approval_roles_present",
                "prior_same_day_category_spend_minor"
              ],
              "type": "string"
            },
            {
              "const": "daily_category_total_minor",
              "type": "string"
            }
          ],
          "title": "Field"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "lt",
            "lte",
            "gt",
            "gte",
            "contains"
          ],
          "title": "Operator",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "confidence_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Percent"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "minItems": 1,
          "title": "Effects",
          "type": "array"
        },
        "overrides": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverrideRef"
          },
          "title": "Overrides",
          "type": "array"
        },
        "provenance": {
          "discriminator": {
            "mapping": {
              "session_revision": "#/$defs/SessionRevisionProvenance",
              "text_citation": "#/$defs/TextRuleProvenance"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextRuleProvenance"
            },
            {
              "$ref": "#/$defs/SessionRevisionProvenance"
            }
          ],
          "title": "Provenance"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "when": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "When",
          "type": "array"
        }
      },
      "required": [
        "description",
        "when",
        "effects",
        "provenance",
        "rule_id"
      ],
      "title": "Rule",
      "type": "object"
    },
    "SessionRevisionProvenance": {
      "additionalProperties": false,
      "properties": {
        "baseline_citation_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Baseline Citation Ids",
          "type": "array"
        },
        "confirmed_at": {
          "format": "date-time",
          "title": "Confirmed At",
          "type": "string"
        },
        "kind": {
          "const": "session_revision",
          "default": "session_revision",
          "title": "Kind",
          "type": "string"
        },
        "operation_index": {
          "maximum": 2,
          "minimum": 0,
          "title": "Operation Index",
          "type": "integer"
        },
        "proposal_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "operation_index",
        "confirmed_at",
        "baseline_citation_ids"
      ],
      "title": "SessionRevisionProvenance",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "start",
        "end",
        "quote",
        "quote_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "TextRuleProvenance": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Citation Id",
          "type": "string"
        },
        "kind": {
          "const": "text_citation",
          "default": "text_citation",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "citation_id",
        "span"
      ],
      "title": "TextRuleProvenance",
      "type": "object"
    },
    "UnsupportedClause": {
      "additionalProperties": false,
      "properties": {
        "affected_dimensions": {
          "items": {
            "enum": [
              "eligibility",
              "receipt_requirement",
              "approval_requirement",
              "claim_cap_minor",
              "daily_category_cap_minor"
            ],
            "type": "string"
          },
          "minLength": 1,
          "title": "Affected Dimensions",
          "type": "array",
          "uniqueItems": true
        },
        "clause_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Clause Id",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "unsupported_vocabulary",
            "unsupported_logic",
            "ambiguous_language",
            "invalid_citation",
            "unsupported_aggregation",
            "unsupported_currency"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "review_status": {
          "default": "provisional",
          "enum": [
            "provisional",
            "session_confirmed"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "when_hint": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Predicate"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When Hint"
        }
      },
      "required": [
        "clause_id",
        "span",
        "reason_code",
        "affected_dimensions"
      ],
      "title": "UnsupportedClause",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "excluded_rule_count": {
      "default": 0,
      "minimum": 0,
      "title": "Excluded Rule Count",
      "type": "integer"
    },
    "invariant_drafts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InvariantSuggestion"
      },
      "maxItems": 5,
      "title": "Invariant Drafts",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/PolicyIR"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "policy"
  ],
  "title": "PolicyCompilation",
  "type": "object"
}
