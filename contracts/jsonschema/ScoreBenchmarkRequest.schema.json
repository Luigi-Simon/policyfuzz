{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "enum": [
                "COMPLIANT",
                "NONCOMPLIANT"
              ],
              "type": "string"
            }
          ],
          "title": "Expected Value"
        },
        "gold_label_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gold Label Id"
        },
        "mechanical_relation_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanical Relation Id"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "lte",
            "gte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "origin": {
          "enum": [
            "gold",
            "session_confirmed",
            "mechanical"
          ],
          "title": "Origin",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_invariant_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Invariant Id"
        },
        "target_kind": {
          "enum": [
            "effect_value",
            "compliance_value"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "target_kind",
        "dimension",
        "operator",
        "expected_value",
        "origin"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "actual_value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "enum": [
                "COMPLIANT",
                "NONCOMPLIANT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Value"
        },
        "assertion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "status"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "BenchmarkDefect": {
      "additionalProperties": false,
      "properties": {
        "defect_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Defect Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "expected_finding_fingerprint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Finding Fingerprint Sha256"
        },
        "finding_type": {
          "enum": [
            "structural_gap",
            "conflict",
            "intent_breach",
            "regression",
            "unsupported_clause",
            "potential_loophole"
          ],
          "title": "Finding Type",
          "type": "string"
        },
        "partition": {
          "default": "visible",
          "enum": [
            "visible",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "permitted_witness_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Permitted Witness Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_signature_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Signature Sha256"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Source Spans",
          "type": "array"
        },
        "target_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        },
        "unsupported_clause": {
          "default": false,
          "title": "Unsupported Clause",
          "type": "boolean"
        }
      },
      "required": [
        "defect_id",
        "finding_type",
        "dimension",
        "target_ids",
        "severity"
      ],
      "title": "BenchmarkDefect",
      "type": "object"
    },
    "BenchmarkManifest": {
      "additionalProperties": false,
      "description": "Private scoring input; must never be nested inside a RunView.",
      "properties": {
        "benchmark_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Benchmark Id",
          "type": "string"
        },
        "defects": {
          "items": {
            "$ref": "#/$defs/BenchmarkDefect"
          },
          "title": "Defects",
          "type": "array"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "engine_version": {
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "gold_scenarios": {
          "items": {
            "$ref": "#/$defs/Scenario"
          },
          "title": "Gold Scenarios",
          "type": "array"
        },
        "policy_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Contract Sha256",
          "type": "string"
        },
        "required_dimensions": {
          "items": {
            "enum": [
              "eligibility",
              "receipt_requirement",
              "approval_requirement",
              "claim_cap_minor",
              "daily_category_cap_minor"
            ],
            "type": "string"
          },
          "title": "Required Dimensions",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seal_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Seal Sha256",
          "type": "string"
        },
        "sealed_at": {
          "format": "date-time",
          "title": "Sealed At",
          "type": "string"
        }
      },
      "required": [
        "benchmark_id",
        "document_sha256",
        "policy_contract_sha256",
        "engine_version",
        "sealed_at",
        "seal_sha256",
        "defects",
        "gold_scenarios",
        "required_dimensions"
      ],
      "title": "BenchmarkManifest",
      "type": "object"
    },
    "ComplianceResult": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPLIANT",
            "NONCOMPLIANT",
            "NOT_APPLICABLE",
            "INCONCLUSIVE",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "status"
      ],
      "title": "ComplianceResult",
      "type": "object"
    },
    "CoverageEvidence": {
      "additionalProperties": false,
      "properties": {
        "predicate_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Index"
        },
        "predicate_outcome": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Outcome"
        },
        "scenario_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Scenario Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "rule",
            "invariant",
            "predicate_branch"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "target_kind",
        "target_id",
        "scenario_ids"
      ],
      "title": "CoverageEvidence",
      "type": "object"
    },
    "CoverageSnapshot": {
      "additionalProperties": false,
      "properties": {
        "covered_invariants": {
          "default": 0,
          "minimum": 0,
          "title": "Covered Invariants",
          "type": "integer"
        },
        "covered_predicate_branches": {
          "default": 0,
          "minimum": 0,
          "title": "Covered Predicate Branches",
          "type": "integer"
        },
        "covered_rules": {
          "default": 0,
          "minimum": 0,
          "title": "Covered Rules",
          "type": "integer"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CoverageEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "missing_invariant_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Invariant Ids",
          "type": "array"
        },
        "missing_rule_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Rule Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "satisfied",
            "COVERAGE_LIMIT_EXCEEDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "targeted_cycles": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Targeted Cycles",
          "type": "integer"
        },
        "total_invariants": {
          "default": 0,
          "minimum": 0,
          "title": "Total Invariants",
          "type": "integer"
        },
        "total_predicate_branches": {
          "default": 0,
          "minimum": 0,
          "title": "Total Predicate Branches",
          "type": "integer"
        },
        "total_rules": {
          "default": 0,
          "minimum": 0,
          "title": "Total Rules",
          "type": "integer"
        }
      },
      "title": "CoverageSnapshot",
      "type": "object"
    },
    "DimensionResult": {
      "additionalProperties": false,
      "properties": {
        "applicable_rule_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Applicable Rule Ids",
          "type": "array"
        },
        "conflicting_values": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "enum": [
                  "allow",
                  "deny"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "required",
                  "not_required"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "none",
                  "manager",
                  "director",
                  "finance"
                ],
                "type": "string"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ]
          },
          "title": "Conflicting Values",
          "type": "array"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "overridden_rule_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Overridden Rule Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "VALUE",
            "GAP",
            "NOT_APPLICABLE",
            "CONFLICT",
            "INCONCLUSIVE",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        },
        "unsupported_clause_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Unsupported Clause Ids",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "dimension",
        "status"
      ],
      "title": "DimensionResult",
      "type": "object"
    },
    "EvaluationReport": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/CoverageSnapshot"
        },
        "engine_version": {
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "inputs": {
          "$ref": "#/$defs/InputHashes"
        },
        "report_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ScenarioEvaluation"
          },
          "title": "Results",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "inputs",
        "engine_version",
        "results",
        "coverage"
      ],
      "title": "EvaluationReport",
      "type": "object"
    },
    "EvaluationTrace": {
      "additionalProperties": false,
      "properties": {
        "compliance_values": {
          "items": {
            "$ref": "#/$defs/ComplianceResult"
          },
          "title": "Compliance Values",
          "type": "array"
        },
        "fired_rule_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Fired Rule Ids",
          "type": "array"
        },
        "predicate_results": {
          "items": {
            "$ref": "#/$defs/PredicateResult"
          },
          "title": "Predicate Results",
          "type": "array"
        },
        "resolved_effects": {
          "items": {
            "$ref": "#/$defs/DimensionResult"
          },
          "title": "Resolved Effects",
          "type": "array"
        },
        "scenario_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_citations": {
          "items": {
            "discriminator": {
              "mapping": {
                "session_revision": "#/$defs/SessionRevisionProvenance",
                "text_citation": "#/$defs/TextRuleProvenance"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextRuleProvenance"
              },
              {
                "$ref": "#/$defs/SessionRevisionProvenance"
              }
            ]
          },
          "title": "Source Citations",
          "type": "array"
        },
        "trace_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trace Sha256",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "fired_rule_ids",
        "predicate_results",
        "resolved_effects",
        "compliance_values",
        "source_citations",
        "trace_sha256"
      ],
      "title": "EvaluationTrace",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assertion Id"
        },
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Citations",
          "type": "array"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "evidence_level": {
          "enum": [
            "mechanically_reproduced",
            "session_confirmed",
            "candidate"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "finding_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "finding_type": {
          "enum": [
            "structural_gap",
            "conflict",
            "intent_breach",
            "regression",
            "unsupported_clause",
            "potential_loophole"
          ],
          "title": "Finding Type",
          "type": "string"
        },
        "fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint Sha256",
          "type": "string"
        },
        "invariant_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invariant Id"
        },
        "review_status": {
          "default": "pending",
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "rule_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "scenario_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Scenario Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "severity_origin": {
          "anyOf": [
            {
              "enum": [
                "session_invariant",
                "session_reviewer"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Origin"
        },
        "traces": {
          "items": {
            "$ref": "#/$defs/TraceRef"
          },
          "minItems": 1,
