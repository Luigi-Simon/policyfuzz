{
  "$defs": {
    "AssertionContent": {
      "additionalProperties": false,
      "description": "Typed assertion content, without oracle origins or private label references.",
      "properties": {
        "assertion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "enum": [
                "COMPLIANT",
                "NONCOMPLIANT"
              ],
              "type": "string"
            }
          ],
          "title": "Expected Value"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "lte",
            "gte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "effect_value",
            "compliance_value"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "target_kind",
        "dimension",
        "operator",
        "expected_value"
      ],
      "title": "AssertionContent",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "enum": [
                "required",
                "not_required"
              ],
              "type": "string"
            },
            {
              "enum": [
                "none",
                "manager",
                "director",
                "finance"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "title": "Effect",
      "type": "object"
    },
    "InvariantSummary": {
      "additionalProperties": false,
      "description": "Session intent for review/editing; no gold or mechanical oracle metadata.",
      "properties": {
        "assertion": {
          "$ref": "#/$defs/AssertionContent"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "invariant_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Invariant Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "when": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "When",
          "type": "array"
        }
      },
      "required": [
        "invariant_id",
        "description",
        "when",
        "assertion",
        "severity"
      ],
      "title": "InvariantSummary",
      "type": "object"
    },
    "OverrideRef": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "eligibility",
            "receipt_requirement",
            "approval_requirement",
            "claim_cap_minor",
            "daily_category_cap_minor"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Rule Id",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "target_rule_id"
      ],
      "title": "OverrideRef",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "enum": [
                "employee_role",
                "expense_category",
                "amount_minor",
                "destination_type",
                "booking_days_before",
                "receipt_present",
                "approval_roles_present",
                "prior_same_day_category_spend_minor"
              ],
              "type": "string"
            },
            {
              "const": "daily_category_total_minor",
              "type": "string"
            }
          ],
          "title": "Field"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "lt",
            "lte",
            "gt",
            "gte",
            "contains"
          ],
          "title": "Operator",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "RuleSummary": {
      "additionalProperties": false,
      "description": "Review of a server-held baseline rule with source citations.",
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/TextRuleProvenance"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "confidence_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Percent"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "minItems": 1,
          "title": "Effects",
          "type": "array"
        },
        "overrides": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverrideRef"
          },
          "title": "Overrides",
          "type": "array"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "when": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "When",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "revision",
        "description",
        "when",
        "effects",
        "citations"
      ],
      "title": "RuleSummary",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "start",
        "end",
        "quote",
        "quote_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "TextRuleProvenance": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Citation Id",
          "type": "string"
        },
        "kind": {
          "const": "text_citation",
          "default": "text_citation",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "citation_id",
        "span"
      ],
      "title": "TextRuleProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_policy_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Baseline Policy Id",
      "type": "string"
    },
    "baseline_policy_sha256": {
      "description": "Artifact SHA256 of the exact server-held baseline PolicyIR.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Policy Sha256",
      "type": "string"
    },
    "document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Document Sha256",
      "type": "string"
    },
    "invariants": {
      "items": {
        "$ref": "#/$defs/InvariantSummary"
      },
      "maxItems": 5,
      "minItems": 3,
      "title": "Invariants",
      "type": "array"
    },
    "kind": {
      "const": "contract",
      "default": "contract",
      "title": "Kind",
      "type": "string"
    },
    "required_dimensions": {
      "items": {
        "enum": [
          "eligibility",
          "receipt_requirement",
          "approval_requirement",
          "claim_cap_minor",
          "daily_category_cap_minor"
        ],
        "type": "string"
      },
      "minLength": 1,
      "title": "Required Dimensions",
      "type": "array",
      "uniqueItems": true
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleSummary"
      },
      "maxItems": 12,
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "baseline_policy_id",
    "baseline_policy_sha256",
    "document_sha256",
    "rules",
    "invariants",
    "required_dimensions"
  ],
  "title": "ContractConfirmation",
  "type": "object"
}
