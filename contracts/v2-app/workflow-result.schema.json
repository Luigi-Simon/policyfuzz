{
  "$defs": {
    "AgentRole": {
      "enum": [
        "Orchestrator Agent",
        "Metric Agent",
        "Sandbox Agent",
        "Judge Agent"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "ApproveAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "approve",
          "default": "approve",
          "title": "Action",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Claim Id",
          "type": "string"
        }
      },
      "required": [
        "claim_id"
      ],
      "title": "ApproveAction",
      "type": "object"
    },
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Actual",
          "type": "string"
        },
        "expected": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "requirement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "step_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Step Refs",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "passed",
        "expected",
        "actual",
        "step_refs"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "CancelAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "cancel",
          "default": "cancel",
          "title": "Action",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Claim Id",
          "type": "string"
        }
      },
      "required": [
        "claim_id"
      ],
      "title": "CancelAction",
      "type": "object"
    },
    "CaseCategory": {
      "enum": [
        "normal",
        "boundary",
        "compound",
        "cascading",
        "adversarial"
      ],
      "title": "CaseCategory",
      "type": "string"
    },
    "CaseVerdict": {
      "enum": [
        "pass",
        "fail",
        "unscored"
      ],
      "title": "CaseVerdict",
      "type": "string"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "policy_clause",
            "metric_case",
            "metric_step",
            "sandbox_message"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CitedFinding": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "citations"
      ],
      "title": "CitedFinding",
      "type": "object"
    },
    "ClaimRecord": {
      "additionalProperties": false,
      "properties": {
        "amount_cents": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Amount Cents",
          "type": "integer"
        },
        "claim_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Claim Id",
          "type": "string"
        },
        "journey_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Journey Id",
          "type": "string"
        },
        "participant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Participant Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        }
      },
      "required": [
        "claim_id",
        "participant_id",
        "journey_id",
        "amount_cents",
        "status"
      ],
      "title": "ClaimRecord",
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "submitted",
        "approved",
        "paid",
        "cancelled"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ConditionTraceStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/EvaluateConditionAction"
        },
        "action_index": {
          "maximum": 63,
          "minimum": 0,
          "title": "Action Index",
          "type": "integer"
        },
        "after_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After State Sha256",
          "type": "string"
        },
        "before_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before State Sha256",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "matches": {
          "title": "Matches",
          "type": "boolean"
        },
        "step_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "action_index",
        "action",
        "matches",
        "detail",
        "before_state_sha256",
        "after_state_sha256"
      ],
      "title": "ConditionTraceStep",
      "type": "object"
    },
    "EvaluateConditionAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "evaluate_condition",
          "default": "evaluate_condition",
          "title": "Action",
          "type": "string"
        },
        "condition_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Condition Id",
          "type": "string"
        },
        "value": {
          "maximum": 100000001,
          "minimum": -1,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "condition_id",
        "value"
      ],
      "title": "EvaluateConditionAction",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "fixture",
        "recorded",
        "live"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "JudgeResult": {
      "additionalProperties": false,
      "description": "Advice only. There are deliberately no writable verdict/count fields.",
      "properties": {
        "cons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CitedFinding"
          },
          "maxItems": 20,
          "title": "Cons",
          "type": "array"
        },
        "errors": {
          "default": [],
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "execution_mode": {
          "$ref": "#/$defs/ExecutionMode"
        },
        "key_interactions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CitedFinding"
          },
          "maxItems": 20,
          "title": "Key Interactions",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "next_steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NextStep"
          },
          "maxItems": 20,
          "title": "Next Steps",
          "type": "array"
        },
        "policy_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Text Sha256",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "pros": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CitedFinding"
          },
          "maxItems": 20,
          "title": "Pros",
          "type": "array"
        },
        "recommendation": {
          "enum": [
            "revise_before_pilot",
            "consider_limited_pilot",
            "insufficient_evidence"
          ],
          "title": "Recommendation",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "partial",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "run_id",
        "policy_version",
        "policy_text_sha256",
        "request_fingerprint",
        "execution_mode",
        "status",
        "summary",
        "recommendation"
      ],
      "title": "JudgeResult",
      "type": "object"
    },
    "MetricCaseResult": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/SubmitAction"
              },
              {
                "$ref": "#/$defs/ApproveAction"
              },
              {
                "$ref": "#/$defs/PayAction"
              },
              {
                "$ref": "#/$defs/CancelAction"
              },
              {
                "$ref": "#/$defs/EvaluateConditionAction"
              },
              {
                "$ref": "#/$defs/UnsupportedAction"
              }
            ]
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssertionResult"
          },
          "maxItems": 16,
          "title": "Assertions",
          "type": "array"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/CaseCategory"
        },
        "initial_state": {
          "$ref": "#/$defs/MetricState"
        },
        "minimal_actions": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SubmitAction"
                  },
                  {
                    "$ref": "#/$defs/ApproveAction"
                  },
                  {
                    "$ref": "#/$defs/PayAction"
                  },
                  {
                    "$ref": "#/$defs/CancelAction"
                  },
                  {
                    "$ref": "#/$defs/EvaluateConditionAction"
                  },
                  {
                    "$ref": "#/$defs/UnsupportedAction"
                  }
                ]
              },
              "maxItems": 32,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimal Actions"
        },
        "plausibility": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Plausibility",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trace": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TraceStep"
              },
              {
                "$ref": "#/$defs/ConditionTraceStep"
              }
            ]
          },
          "maxItems": 32,
          "title": "Trace",
          "type": "array"
        },
        "unscored_reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unscored Reason"
        },
        "verdict": {
          "$ref": "#/$defs/CaseVerdict"
        }
      },
      "required": [
        "case_id",
        "title",
        "category",
        "plausibility",
        "initial_state",
        "actions",
        "verdict"
      ],
      "title": "MetricCaseResult",
      "type": "object"
    },
    "MetricReview": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Assumptions",
          "type": "array"
        },
        "clauses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PolicyClause"
          },
          "maxItems": 16,
          "title": "Clauses",
          "type": "array"
        },
        "goals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PolicyGoal"
          },
          "maxItems": 16,
          "title": "Goals",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Limitations",
          "type": "array"
        },
        "policy_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Text Sha256",
          "type": "string"
        },
        "review_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Fingerprint",
          "type": "string"
        },
        "rules": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricRules"
            },
            {
              "$ref": "#/$defs/PolicyConditions"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rules"
        },
        "status": {
          "$ref": "#/$defs/ReviewStatus"
        }
      },
      "required": [
        "policy_text_sha256",
        "review_fingerprint",
        "status",
        "rules"
      ],
      "title": "MetricReview",
      "type": "object"
    },
    "MetricRules": {
      "additionalProperties": false,
      "properties": {
        "approval_budget_accounting": {
          "enum": [
            "paid_only",
            "paid_and_approved"
          ],
          "title": "Approval Budget Accounting",
          "type": "string"
        },
        "duplicate_scope": {
          "enum": [
            "claim_id",
            "journey"
          ],
          "title": "Duplicate Scope",
          "type": "string"
        },
        "participant_allowance_cents": {
          "maximum": 100000000,
          "minimum": 1,
          "title": "Participant Allowance Cents",
          "type": "integer"
        },
        "payment_budget_recheck": {
          "title": "Payment Budget Recheck",
          "type": "boolean"
        },
        "per_claim_limit_cents": {
          "maximum": 10000000,
          "minimum": 1,
          "title": "Per Claim Limit Cents",
          "type": "integer"
        }
      },
      "required": [
        "per_claim_limit_cents",
        "participant_allowance_cents",
        "approval_budget_accounting",
        "payment_budget_recheck",
        "duplicate_scope"
      ],
      "title": "MetricRules",
      "type": "object"
    },
    "MetricRunResult": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricCaseResult"
          },
          "maxItems": 32,
          "title": "Cases",
          "type": "array"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "generation_method": {
          "default": "rule_templates",
          "enum": [
            "rule_templates",
            "authored_fixture",
            "policy_conditions",
            "policy_scenarios"
          ],
          "title": "Generation Method",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Limitations",
          "type": "array"
        },
        "pass_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pass Rate"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "policy_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Text Sha256",
          "type": "string"
        },
        "policy_version": {
          "const": "1",
          "default": "1",
          "title": "Policy Version",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/MetricReview"
        },
        "review_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Fingerprint",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MetricRunStatus"
        },
        "suite_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suite Sha256",
          "type": "string"
        },
        "unscored": {
          "minimum": 0,
          "title": "Unscored",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "policy_text_sha256",
        "review_fingerprint",
        "status",
        "review",
        "suite_sha256",
        "passed",
        "failed",
        "unscored",
        "pass_rate"
      ],
      "title": "MetricRunResult",
      "type": "object"
    },
    "MetricRunStatus": {
      "enum": [
        "completed",
        "partial",
        "needs_clarification"
      ],
      "title": "MetricRunStatus",
      "type": "string"
    },
    "MetricState": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClaimRecord"
          },
          "maxItems": 64,
          "title": "Claims",
          "type": "array"
        },
        "participants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParticipantTotals"
          },
          "maxItems": 32,
          "title": "Participants",
          "type": "array"
        }
      },
      "title": "MetricState",
      "type": "object"
    },
    "NextStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 20,
          "title": "Citations",
          "type": "array"
        },
        "reason": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "NextStep",
      "type": "object"
    },
    "NumericCondition": {
      "additionalProperties": false,
      "description": "One source-bound comparison, never an inferred whole-policy decision.",
      "properties": {
        "clause_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Clause Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "age_years",
            "assessable_income_cents",
            "annual_income_cents",
            "monthly_income_cents",
            "annual_value_cents",
            "property_count",
            "rest_minutes",
            "notice_days",
            "weekly_work_minutes"
          ],
          "title": "Field",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "operator": {
          "enum": [
            "ge",
            "gt",
            "le",
            "lt",
            "eq"
          ],
          "title": "Operator",
          "type": "string"
        },
        "source_end": {
          "minimum": 1,
          "title": "Source End",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_start": {
          "minimum": 0,
          "title": "Source Start",
          "type": "integer"
        },
        "threshold": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Threshold",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "clause_id",
        "field",
        "operator",
        "threshold",
        "source_start",
        "source_end",
        "source_sha256"
      ],
      "title": "NumericCondition",
      "type": "object"
    },
    "ParticipantTotals": {
      "additionalProperties": false,
      "properties": {
        "paid_cents": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Paid Cents",
          "type": "integer"
        },
        "participant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Participant Id",
          "type": "string"
        },
        "reserved_cents": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Reserved Cents",
          "type": "integer"
        }
      },
      "required": [
        "participant_id",
        "paid_cents",
        "reserved_cents"
      ],
      "title": "ParticipantTotals",
      "type": "object"
    },
    "PayAction": {
