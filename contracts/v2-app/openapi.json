            "type": "integer"
          },
          "source_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Source Refs",
            "type": "array"
          },
          "translation_status": {
            "$ref": "#/components/schemas/TranslationStatus"
          }
        },
        "required": [
          "message_id",
          "sequence",
          "persona_id",
          "content",
          "translation_status"
        ],
        "title": "SandboxMessage",
        "type": "object"
      },
      "SandboxStatus": {
        "enum": [
          "completed",
          "partial",
          "failed",
          "cancelled"
        ],
        "title": "SandboxStatus",
        "type": "string"
      },
      "SourceEvidence": {
        "additionalProperties": false,
        "properties": {
          "excerpt": {
            "minLength": 1,
            "title": "Excerpt",
            "type": "string"
          },
          "record_id": {
            "minLength": 1,
            "title": "Record Id",
            "type": "string"
          },
          "source_id": {
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "record_id",
          "title",
          "excerpt"
        ],
        "title": "SourceEvidence",
        "type": "object"
      },
      "SubmitAction": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "submit",
            "default": "submit",
            "title": "Action",
            "type": "string"
          },
          "amount_cents": {
            "maximum": 100000000.0,
            "minimum": -100000000.0,
            "title": "Amount Cents",
            "type": "integer"
          },
          "claim_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Claim Id",
            "type": "string"
          },
          "journey_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Journey Id",
            "type": "string"
          },
          "participant_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Participant Id",
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "participant_id",
          "journey_id",
          "amount_cents"
        ],
        "title": "SubmitAction",
        "type": "object"
      },
      "TraceStep": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "boolean"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubmitAction"
              },
              {
                "$ref": "#/components/schemas/ApproveAction"
              },
              {
                "$ref": "#/components/schemas/PayAction"
              },
              {
                "$ref": "#/components/schemas/CancelAction"
              },
              {
                "$ref": "#/components/schemas/UnsupportedAction"
              }
            ],
            "title": "Action"
          },
          "action_index": {
            "maximum": 63.0,
            "minimum": 0.0,
            "title": "Action Index",
            "type": "integer"
          },
          "after_state_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "After State Sha256",
            "type": "string"
          },
          "before_state_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Before State Sha256",
            "type": "string"
          },
          "detail": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          },
          "participant_paid_cents_after": {
            "minimum": 0.0,
            "title": "Participant Paid Cents After",
            "type": "integer"
          },
          "participant_paid_cents_before": {
            "minimum": 0.0,
            "title": "Participant Paid Cents Before",
            "type": "integer"
          },
          "participant_reserved_cents_after": {
            "minimum": 0.0,
            "title": "Participant Reserved Cents After",
            "type": "integer"
          },
          "participant_reserved_cents_before": {
            "minimum": 0.0,
            "title": "Participant Reserved Cents Before",
            "type": "integer"
          },
          "step_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Step Id",
            "type": "string"
          }
        },
        "required": [
          "step_id",
          "action_index",
          "action",
          "accepted",
          "detail",
          "before_state_sha256",
          "after_state_sha256",
          "participant_paid_cents_before",
          "participant_paid_cents_after",
          "participant_reserved_cents_before",
          "participant_reserved_cents_after"
        ],
        "title": "TraceStep",
        "type": "object"
      },
      "TranslationStatus": {
        "enum": [
          "original_english",
          "translated",
          "unavailable"
        ],
        "title": "TranslationStatus",
        "type": "string"
      },
      "UnsupportedAction": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "title": "Action",
            "type": "string"
          },
          "parameters": {
            "default": [],
            "items": {
              "type": "string"
            },
            "maxItems": 16,
            "title": "Parameters",
            "type": "array"
          }
        },
        "required": [
          "action"
        ],
        "title": "UnsupportedAction",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "PolicyFuzz v2 API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/health": {
      "get": {
        "operationId": "health_api_v2_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v2/metric/prepare": {
      "post": {
        "operationId": "prepare_metric_api_v2_metric_prepare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareMetricRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricReview"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Prepare Metric"
      }
    },
    "/api/v2/metric/runs": {
      "post": {
        "operationId": "metric_run_api_v2_metric_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunMetricRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricRunResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Metric Run"
      }
    },
    "/api/v2/metric/sample": {
      "get": {
        "operationId": "metric_sample_api_v2_metric_sample_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPolicyInput"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metric Sample"
      }
    },
    "/api/v2/runs": {
      "post": {
        "operationId": "create_run_api_v2_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSandboxResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "summary": "Create Run"
      }
    }
  }
}
