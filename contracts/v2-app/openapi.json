{
  "components": {
    "schemas": {
      "CreateRunRequest": {
        "additionalProperties": false,
        "properties": {
          "fixture_name": {
            "default": "completed",
            "enum": [
              "completed",
              "partial_translation_unavailable"
            ],
            "title": "Fixture Name",
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/RunPolicyInput"
          }
        },
        "required": [
          "policy"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "ExecutionMode": {
        "enum": [
          "fixture",
          "recorded",
          "live"
        ],
        "title": "ExecutionMode",
        "type": "string"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "execution_mode": {
            "const": "fixture",
            "default": "fixture",
            "title": "Execution Mode",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "Persona": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "display_name": {
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "persona_id": {
            "minLength": 1,
            "title": "Persona Id",
            "type": "string"
          }
        },
        "required": [
          "persona_id",
          "display_name",
          "description"
        ],
        "title": "Persona",
        "type": "object"
      },
      "PublicError": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "PublicError",
        "type": "object"
      },
      "PublicSandboxResult": {
        "additionalProperties": false,
        "description": "Explicit public allowlist for Sandbox evidence.",
        "properties": {
          "configured_stakeholder_count": {
            "minimum": 0.0,
            "title": "Configured Stakeholder Count",
            "type": "integer"
          },
          "errors": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Errors",
            "type": "array"
          },
          "execution_mode": {
            "$ref": "#/components/schemas/ExecutionMode"
          },
          "limitations": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "messages": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SandboxMessage"
            },
            "title": "Messages",
            "type": "array"
          },
          "observed_stakeholder_count": {
            "minimum": 0.0,
            "title": "Observed Stakeholder Count",
            "type": "integer"
          },
          "personas": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Persona"
            },
            "title": "Personas",
            "type": "array"
          },
          "policy_text_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Policy Text Sha256",
            "type": "string"
          },
          "policy_title": {
            "minLength": 1,
            "title": "Policy Title",
            "type": "string"
          },
          "policy_version": {
            "minLength": 1,
            "title": "Policy Version",
            "type": "string"
          },
          "request_fingerprint": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Request Fingerprint",
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "requested_stakeholder_count": {
            "minimum": 1.0,
            "title": "Requested Stakeholder Count",
            "type": "integer"
          },
          "run_id": {
            "minLength": 1,
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": "2.0",
            "default": "2.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sources": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SourceEvidence"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/SandboxStatus"
          }
        },
        "required": [
          "request_id",
          "run_id",
          "policy_version",
          "policy_title",
          "policy_text_sha256",
          "request_fingerprint",
          "execution_mode",
          "status",
          "requested_stakeholder_count",
          "configured_stakeholder_count",
          "observed_stakeholder_count"
        ],
        "title": "PublicSandboxResult",
        "type": "object"
      },
      "RunPolicyInput": {
        "additionalProperties": false,
        "description": "The four policy fields accepted by the first-run milestone.",
        "properties": {
          "agent_count": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Agent Count",
            "type": "integer"
          },
          "agent_seed": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Agent Seed",
            "type": "string"
          },
          "description": {
            "maxLength": 50000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "description",
          "agent_seed",
          "agent_count"
        ],
        "title": "RunPolicyInput",
        "type": "object"
      },
      "SandboxMessage": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "message_id": {
            "minLength": 1,
            "title": "Message Id",
            "type": "string"
          },
          "persona_id": {
            "minLength": 1,
            "title": "Persona Id",
            "type": "string"
          },
          "recorded_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recorded At"
          },
          "reply_to_message_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Reply To Message Ids",
            "type": "array"
          },
          "round_number": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Round Number"
          },
          "sequence": {
            "minimum": 1.0,
            "title": "Sequence",
            "type": "integer"
          },
          "source_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Source Refs",
            "type": "array"
          },
          "translation_status": {
            "$ref": "#/components/schemas/TranslationStatus"
          }
        },
        "required": [
          "message_id",
          "sequence",
          "persona_id",
          "content",
          "translation_status"
        ],
        "title": "SandboxMessage",
        "type": "object"
      },
      "SandboxStatus": {
        "enum": [
          "completed",
          "partial",
          "failed",
          "cancelled"
        ],
        "title": "SandboxStatus",
        "type": "string"
      },
      "SourceEvidence": {
        "additionalProperties": false,
        "properties": {
          "excerpt": {
            "minLength": 1,
            "title": "Excerpt",
            "type": "string"
          },
          "record_id": {
            "minLength": 1,
            "title": "Record Id",
            "type": "string"
          },
          "source_id": {
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "record_id",
          "title",
          "excerpt"
        ],
        "title": "SourceEvidence",
        "type": "object"
      },
      "TranslationStatus": {
        "enum": [
          "original_english",
          "translated",
          "unavailable"
        ],
        "title": "TranslationStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "PolicyFuzz v2 Fixture API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/health": {
      "get": {
        "operationId": "health_api_v2_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v2/runs": {
      "post": {
        "operationId": "create_run_api_v2_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSandboxResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "summary": "Create Run"
      }
    }
  }
}
