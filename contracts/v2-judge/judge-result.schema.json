{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "policy_clause",
            "metric_case",
            "metric_step",
            "sandbox_message"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CitedFinding": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "citations"
      ],
      "title": "CitedFinding",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "fixture",
        "recorded",
        "live"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "NextStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 20,
          "title": "Citations",
          "type": "array"
        },
        "reason": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "NextStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Advice only. There are deliberately no writable verdict/count fields.",
  "properties": {
    "cons": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CitedFinding"
      },
      "maxItems": 20,
      "title": "Cons",
      "type": "array"
    },
    "errors": {
      "default": [],
      "items": {
        "maxLength": 8000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "execution_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "key_interactions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CitedFinding"
      },
      "maxItems": 20,
      "title": "Key Interactions",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "maxLength": 8000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "next_steps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "maxItems": 20,
      "title": "Next Steps",
      "type": "array"
    },
    "policy_text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Text Sha256",
      "type": "string"
    },
    "policy_version": {
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "pros": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CitedFinding"
      },
      "maxItems": 20,
      "title": "Pros",
      "type": "array"
    },
    "recommendation": {
      "enum": [
        "revise_before_pilot",
        "consider_limited_pilot",
        "insufficient_evidence"
      ],
      "title": "Recommendation",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "policy_version",
    "policy_text_sha256",
    "request_fingerprint",
    "execution_mode",
    "status",
    "summary",
    "recommendation"
  ],
  "title": "JudgeResult",
  "type": "object"
}
