{
  "$defs": {
    "ExecutionMode": {
      "enum": [
        "fixture",
        "recorded",
        "live"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "OriginalRecord": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "language": {
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "reply_to_record_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reply To Record Ids",
          "type": "array"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "speaker_id": {
          "minLength": 1,
          "title": "Speaker Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "speaker_id",
        "source_id",
        "content",
        "language"
      ],
      "title": "OriginalRecord",
      "type": "object"
    },
    "Persona": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "persona_id": {
          "minLength": 1,
          "title": "Persona Id",
          "type": "string"
        }
      },
      "required": [
        "persona_id",
        "display_name",
        "description"
      ],
      "title": "Persona",
      "type": "object"
    },
    "SandboxMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "persona_id": {
          "minLength": 1,
          "title": "Persona Id",
          "type": "string"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        },
        "reply_to_message_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reply To Message Ids",
          "type": "array"
        },
        "round_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round Number"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "source_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "translation_status": {
          "$ref": "#/$defs/TranslationStatus"
        }
      },
      "required": [
        "message_id",
        "sequence",
        "persona_id",
        "content",
        "translation_status"
      ],
      "title": "SandboxMessage",
      "type": "object"
    },
    "SandboxStatus": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "cancelled"
      ],
      "title": "SandboxStatus",
      "type": "string"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "record_id",
        "title",
        "excerpt"
      ],
      "title": "SourceEvidence",
      "type": "object"
    },
    "TranslationStatus": {
      "enum": [
        "original_english",
        "translated",
        "unavailable"
      ],
      "title": "TranslationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "configured_stakeholder_count": {
      "minimum": 0,
      "title": "Configured Stakeholder Count",
      "type": "integer"
    },
    "errors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "execution_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "messages": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SandboxMessage"
      },
      "title": "Messages",
      "type": "array"
    },
    "observed_stakeholder_count": {
      "minimum": 0,
      "title": "Observed Stakeholder Count",
      "type": "integer"
    },
    "original_records": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OriginalRecord"
      },
      "title": "Original Records",
      "type": "array"
    },
    "personas": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Persona"
      },
      "title": "Personas",
      "type": "array"
    },
    "policy_text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Text Sha256",
      "type": "string"
    },
    "policy_title": {
      "minLength": 1,
      "title": "Policy Title",
      "type": "string"
    },
    "policy_version": {
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "requested_stakeholder_count": {
      "minimum": 1,
      "title": "Requested Stakeholder Count",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceEvidence"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/SandboxStatus"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "policy_version",
    "policy_title",
    "policy_text_sha256",
    "request_fingerprint",
    "execution_mode",
    "status",
    "requested_stakeholder_count",
    "configured_stakeholder_count",
    "observed_stakeholder_count"
  ],
  "title": "SandboxResult",
  "type": "object"
}
